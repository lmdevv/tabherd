---
import TabherdMark from "./TabherdMark.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <TabherdMark class="site-mark" static />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.55rem;
    color: var(--tabherd-ink);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .site-title :global(.site-mark) {
    width: 2.1rem;
    height: auto;
    flex: none;
  }
</style>
