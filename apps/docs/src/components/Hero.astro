---
import BrowserDemo from "./BrowserDemo.astro";
import TabbyMark from "./TabbyMark.astro";
---

<div class="tabby-hero">
  <div class="hero-copy">
    <TabbyMark class="hero-mark" />
    <h1 id="_top" data-page-title>Your browser.<br />Your agent.</h1>
    <p class="hero-description">
      Tabby connects your agent to the browser you already use. Tidy tabs, read pages, and get
      things done in your real profile, with nothing leaving your machine.
    </p>
    <div class="hero-actions">
      <a class="start-link" href="/quick-start/">Get started <span aria-hidden="true">→</span></a>
      <a class="reference-link" href="/tools/">Browse the tools</a>
    </div>
  </div>
  <BrowserDemo />
</div>
