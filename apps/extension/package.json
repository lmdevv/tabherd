{
  "name": "extension",
  "version": "0.0.1",
  "private": true,
  "description": "A local browser bridge for Tabherd",
  "type": "module",
  "scripts": {
    "dev": "wxt --port 5555",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "wxt prepare",
    "check-types": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@tabherd/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
